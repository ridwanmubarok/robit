# ============================================================
# Rogatekno Labs - Engine Configuration
# ============================================================

# --- Hardware Mode ---
# WINDOWS: Set USE_GPU=true to activate NVIDIA/AMD/Intel via Vulkan.
# MAC M1/M2/M3: Set USE_GPU=false for native high-speed CPU/Unified Memory.
USE_GPU=true

# --- Model ---
MODEL_PATH=models/Bonsai-8B-Q1_0.gguf

# --- Engine Paths (Auto-detects .exe on Windows) ---
# Direct path to your llama-server binary.
CPU_ENGINE_PATH=bin/llama-server
GPU_ENGINE_PATH=bin-vulkan/llama-server

# --- Server Ports ---
LLM_PORT=8888
WEB_PORT=8000

# --- Performance Tuning ---
# MAC M1/M2/M3: Recommended THREADS=4 or 8
THREADS=4
CONTEXT_SIZE=4096
BATCH_SIZE=1024
UBATCH_SIZE=512

# --- Advanced ---
GPU_LAYERS=99
FLASH_ATTENTION=on
KV_QUANT=q4_0
NGRAM_SPEC=true
NGRAM_DRAFT=8



