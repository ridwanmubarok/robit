# ============================================================
# Rogatekno Labs - Engine Configuration
# ============================================================

# --- Mode ---
# Set USE_GPU=true to activate AMD RX 580 via Vulkan
# Set USE_GPU=false to use PrismML 1-bit native CPU mode
USE_GPU=true

# --- Model ---
MODEL_PATH=models/Bonsai-8B-Q1_0.gguf

# --- Engine Paths ---
CPU_ENGINE_PATH=bin/llama-server.exe
GPU_ENGINE_PATH=bin-vulkan/llama-server.exe

# --- Server Ports ---
LLM_PORT=8888
WEB_PORT=8000

# --- CPU Tuning ---
THREADS=4
CONTEXT_SIZE=2048
BATCH_SIZE=1024
UBATCH_SIZE=512

# --- GPU Tuning (Vulkan) ---
GPU_LAYERS=99

# --- Features ---
FLASH_ATTENTION=on
KV_QUANT=q4_0
NGRAM_SPEC=true
NGRAM_DRAFT=8
