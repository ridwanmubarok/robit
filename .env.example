# ============================================================
# Rogatekno Labs - Engine Configuration
# ============================================================

# --- Hardware Mode ---
# Set USE_GPU=true to enable hardware acceleration.
# Set USE_GPU=false to use high-speed 1-bit native CPU mode.
USE_GPU=true

# --- GPU Backend ---
# select backend for accelation Graphics:
# cuda   -> for NVIDIA RTX/GTX
# vulkan -> for AMD Radeon / Intel Arc / Universal
# metal  -> for Apple Silicon (Mac M1/M2/M3)
GPU_BACKEND=vulkan

# --- Model ---
MODEL_PATH=models/Bonsai-8B-Q1_0.gguf

# --- Server Ports ---
LLM_PORT=8888
WEB_PORT=8000

# --- Performance Tuning ---
# MAC M1/M2/M3: Recommended THREADS=4 or 8
# PC/Desktop: Match your physical CPU cores
THREADS=4
CONTEXT_SIZE=4096
BATCH_SIZE=1024
UBATCH_SIZE=512

# --- Advanced ---
GPU_LAYERS=99
FLASH_ATTENTION=on
KV_QUANT=q4_0
NGRAM_SPEC=true
NGRAM_DRAFT=8



